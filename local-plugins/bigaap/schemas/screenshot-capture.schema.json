{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bigaap/screenshot-capture",
  "title": "Screenshot Capture",
  "description": "Input to the screenshot evidence path. Observations are supplied by a measurement tool or a vision model; the intake validates and ceiling-caps them rather than producing them, because a layer that both invents values and judges them checks nothing.",
  "type": "object",
  "required": ["$extractor", "meta", "regions", "observations"],
  "additionalProperties": false,
  "properties": {
    "$extractor": { "type": "string", "const": "bigaap/screenshot" },
    "$version": { "type": "string" },

    "meta": {
      "type": "object",
      "required": ["images"],
      "additionalProperties": false,
      "properties": {
        "capturedAt": { "type": "string" },
        "devicePixelRatio": { "type": "number" },
        "scaleKnown": {
          "type": "boolean",
          "description": "Whether the image's scale relative to CSS pixels is known. When false, every pixel measurement is capped at `estimated` — a number without a scale has no unit."
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["file", "width", "height"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "width": { "type": "number", "minimum": 1 },
              "height": { "type": "number", "minimum": 1 },
              "viewport": {
                "type": ["number", "null"],
                "description": "The capture width in CSS pixels, when known. Null means rendered widths cannot be tied to CSS widths."
              },
              "captureDate": { "type": ["string", "null"] }
            }
          }
        }
      }
    },

    "regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/region" }
    },

    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    }
  },

  "$defs": {
    "region": {
      "type": "object",
      "required": ["id", "kind", "detectionMethod", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "full-page", "header", "hero", "navigation", "main-content",
            "card", "form", "footer", "interaction-state"
          ]
        },
        "detectionMethod": {
          "type": "string",
          "enum": ["explicit", "inferred"],
          "description": "`inferred` means the bounds were detected, so every measurement inside inherits that uncertainty."
        },
        "coordinates": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "minimum": 0 },
            "y": { "type": "number", "minimum": 0 },
            "width": { "type": "number", "minimum": 1 },
            "height": { "type": "number", "minimum": 1 }
          }
        },
        "image": { "type": ["string", "null"] },
        "viewport": { "type": ["number", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": ["string", "null"] }
      }
    },

    "observation": {
      "type": "object",
      "required": ["claim", "value", "technique", "regionId"],
      "additionalProperties": false,
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "array", "boolean", "null"] },
        "unit": { "type": ["string", "null"] },
        "technique": {
          "type": "string",
          "enum": ["visual-observation", "pixel-measurement", "OCR", "region-comparison"]
        },
        "regionId": {
          "type": "string",
          "description": "Mandatory. A screenshot measurement without a source region is invalid, not merely weak."
        },
        "status": {
          "type": "string",
          "enum": ["observed", "inferred", "estimated"],
          "description": "The status PROPOSED by the observer. The intake caps it; it can never be raised."
        },
        "qualitative": {
          "type": "boolean",
          "description": "True for relationships rather than quantities. A relationship survives rescaling, so it may reach `observed` even when the scale is unknown."
        },
        "coordinates": { "type": ["object", "null"] },
        "state": { "type": ["string", "null"] },
        "sampleSize": { "type": "number", "minimum": 1 },
        "agreement": { "type": "number", "minimum": 0, "maximum": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "normalized": { "type": ["object", "null"] },
        "raw": { "type": "array" },
        "notes": { "type": "string" }
      }
    }
  }
}
